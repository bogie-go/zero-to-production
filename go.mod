// Pinned here so a fresh clone needs only Go: `go tool goose`, `go tool
// sqlc` and the live reload `bogie server` uses, never a global install
// that drifts from what the binary embeds or what the committed models
// were generated with.
tool (
	github.com/air-verse/air
	github.com/bogie-go/credentials/cmd/credentials
	github.com/pressly/goose/v3/cmd/goose
	github.com/sqlc-dev/sqlc/cmd/sqlc
)
